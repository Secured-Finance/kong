# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values

project_id = "your-gcp-project-id"
region     = "us-central1"
gce_zone   = "us-central1-a"

# Optional: Override default values
# vpc_name               = "vpc-kong"
# subnet_ip_cidr         = "10.10.0.0/20"
# gce_instance_name      = "kong-ingest-redis"
# gce_machine_type       = "e2-standard-2"
# gce_boot_disk_size_gb  = 50
# ar_repo_name           = "kong"
# sa_web_name            = "sa-kong-web"
# sa_gce_name            = "sa-kong-gce"
# sa_jobs_name           = "sa-kong-jobs"
