# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values

# Required variables
project_id = "your-gcp-project-id"
region     = "asia-northeast1"
gce_zone   = "asia-northeast1-a"

# Optional: Resource names (environment-specific)
# vpc_name          = "prd-vpc-kong"
# gce_instance_name = "prd-kong-ingest-redis"
# subnet_name       = "prd-subnet-kong"
# router_name       = "prd-router-kong"
# nat_name          = "prd-nat-kong"
# vpc_connector_name = "prd-svc-connector-kong"
# firewall_ssh_name  = "prd-allow-ssh-kong"
# firewall_redis_name = "prd-allow-redis-kong"

# Optional: Service account names (runtime services only)
# sa_web_name  = "prd-sa-kong-web"
# sa_gce_name  = "prd-sa-kong-gce"
# sa_jobs_name = "prd-sa-kong-jobs"

# Optional: Network configuration
# subnet_ip_cidr        = "10.10.0.0/20"
# vpc_connector_ip_cidr = "10.8.0.0/28"

# Optional: GCE instance configuration
# gce_machine_type      = "e2-standard-2"
# gce_boot_disk_size_gb = 50
